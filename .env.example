# ---------------------------------------------------------------------------
# AI Spec Explorer — server-side environment.
# Copy to .env and fill in. NOTHING here is exposed to the client bundle:
# there are no NEXT_PUBLIC_* variables on purpose.
# ---------------------------------------------------------------------------

# Which LLM backs the behavior compiler: `glean` (default) or `bedrock`.
# The Glean settings below apply only to `glean`; the Bedrock ones only to
# `bedrock`. Everything else in this file is shared.
COMPILER_PROVIDER=glean

# --- Amazon Bedrock (COMPILER_PROVIDER=bedrock) ----------------------------
#
# Called through the Converse API, so switching model is this one value and
# nothing else.
BEDROCK_MODEL_ID=openai.gpt-5.6-luna

# Region the model is enabled in. Some models are only reachable through a
# cross-region inference profile, in which case the id is prefixed — e.g.
# `us.openai.gpt-5.6-luna`. If Bedrock rejects the id, that prefix is the
# first thing to try.
AWS_REGION=us-west-2

# 0 keeps compiles reproducible: the same spec should compile the same way
# twice. Raise it only if you want variety, which a spec compiler does not.
BEDROCK_TEMPERATURE=0

# NO AWS CREDENTIALS GO HERE. The AWS SDK resolves them from its own provider
# chain — environment, shared config/SSO, or an instance/task role — so this
# app never reads or stores an AWS secret. In AWS, attach a role with
# bedrock:InvokeModel and set no keys at all.

# --- Glean credentials: set EXACTLY ONE of the two options below -----------
#
# Option A (preferred for a server): OAuth client_credentials. The app mints
# its own short-lived tokens, so no human is in the loop and the secret can be
# rotated without redeploying. Wyze's Glean advertises this grant at
# https://wyze-be.glean.com/oauth/token
GLEAN_CLIENT_ID=
GLEAN_CLIENT_SECRET=
# Scope requested for that token. `chat` is what the compiler needs.
GLEAN_SCOPE=chat

# Option B: a long-lived platform token from the Glean admin console
# (https://app.glean.com/admin/platform/token). Leave blank if using Option A —
# setting both is rejected at startup rather than silently preferring one.
GLEAN_API_KEY=

# Glean instance name. The backend origin is https://<instance>-be.glean.com.
GLEAN_INSTANCE=wyze

# Optional: full backend origin, for deployments that don't follow the
# <instance>-be.glean.com pattern. Overrides GLEAN_INSTANCE when set.
# GLEAN_BASE_URL=https://wyze-be.glean.com

# Which Glean agent answers. LEAVE THIS AS GPT.
#   GPT       - talks straight to the LLM, no company-knowledge retrieval.
#   DEFAULT   - retrieves from company knowledge (Confluence, Jira, Slack, ...)
#   FAST      - agentic engine, retrieval-capable, must be enabled in the deployment
#   ADVANCED  - same, slower and higher quality
# Anything other than GPT lets Glean blend real Wyze subscription docs into
# answers that are supposed to be derived only from the spec in the editor.
# That voids this tool's core guarantee. See README "Why agent=GPT".
GLEAN_AGENT=GPT

# Reasoning mode passed through to Glean. DEFAULT is fine for GPT.
GLEAN_MODE=DEFAULT

# --- Company knowledge (optional second opinion) ---------------------------
# When true, Ask also asks Glean's RETRIEVAL agent the same question against
# company content (Confluence, Jira, Slack) and shows it in a SEPARATE panel.
#
# This is the one place retrieval is wanted. The spec answer still runs with
# GLEAN_AGENT=GPT and stays spec-only; the two never share a call, a prompt or
# a panel, because a reader must always be able to tell which claims the
# specification actually backs. Useful because the knowledge base is distilled
# FROM Confluence: when the two disagree, one of them is stale.
GLEAN_COMPANY_KNOWLEDGE=false
# Must not be GPT — GPT does not retrieve. Rejected at startup if it is.
GLEAN_COMPANY_KNOWLEDGE_AGENT=DEFAULT

# Only needed when GLEAN_API_KEY is a *global* token rather than a user-scoped
# one: Glean requires the user to act as. Set to the service owner's email.
# GLEAN_ACT_AS=

# GitHub fine-grained PAT, scoped to the single spec repo with exactly:
#   Repository permissions -> Contents: Read and write
#   Repository permissions -> Pull requests: Read and write
# No org, account, or workflow scopes. See README "GitHub token scoping".
GITHUB_TOKEN=github_pat_...

# Repo that holds the Product Behavior Specification.
GITHUB_OWNER=wyzelabs
GITHUB_REPO=product-behavior-spec

# Directory holding every team's specs. Each team is a folder under here
# containing a parent.md — that is all it takes for the app to see a team.
# Every path the app reads or writes is confined to this subtree, so it must
# not be empty.
#
#   specs/
#     teams.json              display names, order and rule-ID prefixes
#     services/parent.md      the Services knowledge base
#     services/cam-plus/behavior.md
#     hardware/parent.md      the HW Team knowledge base
SPEC_ROOT=specs

# Which team is selected on load.
SPEC_DEFAULT_TEAM=services

# Fallback parent for specs outside the team layout. With team folders each
# spec resolves to its OWN team's parent, so this only matters for a flat,
# single-knowledge-base repo.
SPEC_PARENT_PATH=specs/services/parent.md

# SPEC_PATH is the pre-multi-spec name for SPEC_PARENT_PATH and is still
# honoured, so existing deployments keep working after the upgrade.
# SPEC_PATH=spec/behavior.md

# Branch treated as the state of record.
SPEC_BASE_BRANCH=main

# Commit identity used for spec commits made by this app.
GIT_AUTHOR_NAME=AI Spec Explorer
GIT_AUTHOR_EMAIL=spec-explorer@wyze.com

# When false (the default) every spec change goes out as a branch + pull
# request. Set to true only for a throwaway sandbox repo; the UI still
# requires an explicit confirmation step before a direct commit.
ALLOW_DIRECT_COMMIT=false

# Authentication is required unless explicitly bypassed for local development.
# Never enable the bypass in a production environment.
DEV_AUTH_BYPASS=false
APP_BASE_URL=http://localhost:3000
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAIL_DOMAINS=wyze.com
# Generate at least 32 random bytes and store securely; identical across replicas.
SESSION_SECRET=
