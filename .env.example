# AI Spec Explorer: server-side configuration. Copy to .env; never commit secrets.
# See docs/configuration.md. Do not expose credentials with NEXT_PUBLIC_* variables.

# Production uses Glean. Bedrock is an optional implementation, not enabled in ECS.
COMPILER_PROVIDER=glean

# Optional Bedrock: choose a verified Converse model/inference-profile ID available
# in your AWS account/region. The SDK uses local SSO or a task role; do not add keys.
BEDROCK_MODEL_ID=
AWS_REGION=us-west-2
# Range 0..1. Lower temperature reduces variation but does not guarantee determinism.
BEDROCK_TEMPERATURE=0

# Glean: populate EXACTLY ONE credential option and leave the other empty.
# OAuth requires a tenant-approved client supporting client_credentials and
# client_secret_basic at /oauth/token. ECS secret rotation requires task replacement.
GLEAN_CLIENT_ID=
GLEAN_CLIENT_SECRET=
GLEAN_SCOPE=chat

# Platform token with Chat API access; maps from GLEAN_TOKEN in production Secrets Manager.
GLEAN_API_KEY=
GLEAN_INSTANCE=wyze
# Optional backend origin override; HTTP localhost is for development only.
# GLEAN_BASE_URL=https://wyze-be.glean.com

# Spec-only compiler mode; do not replace with a company-retrieval agent.
GLEAN_AGENT=GPT
GLEAN_MODE=DEFAULT

# Optional separate Ask panel using the service credential's Glean content access.
# Disabled in production. The knowledge agent cannot be GPT.
GLEAN_COMPANY_KNOWLEDGE=false
GLEAN_COMPANY_KNOWLEDGE_AGENT=DEFAULT
# Set only when the Glean token requires an approved service-user identity.
# GLEAN_ACT_AS=

# Fine-grained PAT scoped to one repository: Contents, Pull requests, and Issues
# read/write for all features. No organization/admin/workflow scopes.
# Use a separately scoped sandbox repository when testing write flows.
GITHUB_TOKEN=
GITHUB_OWNER=wyzelabs-inc
GITHUB_REPO=KB-Spec-explorer

# Each team is a directory containing parent.md. teams.json supplies display
# metadata and rule-ID codes. Paths are confined to this subtree.
SPEC_ROOT=specs
SPEC_DEFAULT_TEAM=services
# Legacy flat-layout fallback; team children always resolve to their own parent.
SPEC_PARENT_PATH=specs/services/parent.md
# Legacy alias for SPEC_PARENT_PATH, still supported:
# SPEC_PATH=spec/parent.md
SPEC_BASE_BRANCH=main
GIT_AUTHOR_NAME=AI Spec Explorer
GIT_AUTHOR_EMAIL=spec-explorer@wyze.com

# Production rejects true. Local sandbox-only direct commits require UI confirmation.
ALLOW_DIRECT_COMMIT=false

# Production uses OIDC via Cognito/JumpCloud. test-readonly is a separately
# authorized temporary mode, not the current deployment. Local dev can explicitly
# use DEV_AUTH_BYPASS=true; production rejects that bypass.
AUTH_MODE=oidc
DEV_AUTH_BYPASS=false
APP_BASE_URL=http://localhost:3000
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAIL_DOMAINS=wyze.com
# Generate at least 32 random bytes; store securely and share across replicas.
SESSION_SECRET=
