{
  "name": "ai-spec-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:verify": "NEXT_DIST_DIR=.next-verify next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "stub:glean": "node tools/glean-stub.mjs",
    "migrate:rule-ids": "node --env-file=.env ./node_modules/.bin/vite-node tools/migrate-rule-ids.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1148.0",
    "@octokit/rest": "^22.0.0",
    "jose": "^6.2.12",
    "mermaid": "^12.2.0",
    "next": "^15.5.4",
    "openid-client": "^6.8.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.4",
    "marked": "^18.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "^7.1.6"
  }
}
